flowchart TB
    classDef comp fill:#85bbf0,stroke:#5d82a8,color:#000000,rx:6,ry:6
    classDef extComp fill:#438dd5,stroke:#2e6295,color:#ffffff,rx:6,ry:6
    classDef container fill:#1168bd,stroke:#0b4884,color:#ffffff,rx:6,ry:6
    classDef db fill:#2f6690,stroke:#1d425e,color:#ffffff,rx:6,ry:6
    classDef sysExt fill:#666666,stroke:#444444,color:#ffffff,rx:6,ry:6

    subgraph fe_m2 ["Aplicación Web SPA & Terminal - Módulo M2 (Vue 3, Vite, Pinia)"]
        direction LR
        comp_cred["<b>CredencialView & useQr</b><br/><i>[Vue 3, qrcode.vue, Web Crypto]</i><br/>Genera QR online (60s) o firma HMAC offline"]:::comp
        store_local[("<b>Almacenamiento Cliente</b><br/><i>[Pinia & localStorage]</i><br/>fitzone_user_perfil y colas offline")]:::db
        comp_off["<b>OfflineValidator & Sync</b><br/><i>[TypeScript, Web Crypto API]</i><br/>Verifica HMAC/ciudad/TTL y sincroniza cola"]:::comp
        comp_recep["<b>RecepcionView & ValidacionAcceso</b><br/><i>[Vue 3, html5-qrcode, useAforo]</i><br/>Escaneo QR/DNI, fallback local y aforo"]:::comp
    end

    subgraph be_m2 ["API Backend NestJS - Módulo M2 Control de Acceso"]
        direction TB

        subgraph capa_http ["Controladores REST"]
            direction LR
            ctrl_qr["<b>QrController</b><br/><i>[NestJS Controller]</i><br/>GET /access/qr/generate"]:::comp
            ctrl_acc["<b>AccesosController</b><br/><i>[NestJS Controller]</i><br/>Validación ingreso/egreso, aforo y sync"]:::comp
        end

        subgraph capa_servicios ["Servicios de Dominio y Realtime"]
            direction LR
            srv_qr["<b>QrService</b><br/><i>[NestJS Service]</i><br/>Tokens efímeros 60s HMAC-SHA256"]:::comp
            srv_acc_be["<b>AccesosService</b><br/><i>[NestJS Service]</i><br/>Validación QR/DNI, mora, RN-01 y sync"]:::comp
            srv_aforo_rt["<b>AforoRealtimeService</b><br/><i>[Realtime Publisher]</i><br/>Emite aforo_actualizado en canal sede"]:::comp
        end

        subgraph capa_repos ["Persistencia"]
            direction LR
            repo_acc["<b>AccesosRepository</b><br/><i>[Prisma Repository]</i><br/>Transacciones de ingreso/egreso y aforo"]:::comp
        end
    end

    guard_auth["<b>SupabaseAuthGuard (Common)</b><br/><i>[NestJS Guard]</i><br/>Verifica JWT local o token Supabase"]:::extComp
    srv_membresias["<b>MembresiasService (M1)</b><br/><i>[NestJS Service]</i><br/>Verifica vigencia y mora (RN-03)"]:::extComp
    srv_usuarios["<b>UsuariosService & Repo (M1)</b><br/><i>[NestJS Service / Repo]</i><br/>Resuelve perfil por ID/DNI y ciudad"]:::extComp
    srv_supabase["<b>SupabaseService (Common)</b><br/><i>[NestJS Service]</i><br/>Valida tokens y emite Broadcast"]:::extComp

    db[("<b>Base de Datos Relacional</b><br/><i>[PostgreSQL / Supabase]</i><br/>registro_accesos, sede, usuario, membresia")]:::db
    sb_auth_rt["<b>Supabase Auth & Realtime</b><br/><i>[Cloud BaaS]</i><br/>Auth Bearer y canal aforo:sede:{idSede}"]:::sysExt

    %% Frontend interno y SPA -> Controllers
    comp_cred -->|"Lee/guarda perfil offline en<br/>[Pinia / Web Storage]"| store_local
    comp_recep -->|"Valida QR offline ante caída de red con<br/>[In-Process / Web Crypto]"| comp_off
    comp_off -->|"Lee y encola eventos pendientes en<br/>[Web Storage API]"| store_local

    comp_cred -->|"Solicita QR dinámico a<br/>[JSON/HTTPS]"| ctrl_qr
    comp_cred -->|"Consulta perfil del socio en<br/>[JSON/HTTPS]"| ctrl_acc
    comp_recep -->|"Envía ingreso, egreso y aforo a<br/>[JSON/HTTPS]"| ctrl_acc
    comp_off -->|"Sincroniza cola offline al reconectar en<br/>[JSON/HTTPS]"| ctrl_acc

    %% Controllers -> Guards & Services
    ctrl_qr -->|"Autentica solicitud con<br/>[In-Process / DI]"| guard_auth
    ctrl_acc -->|"Autentica solicitud con<br/>[In-Process / DI]"| guard_auth
    guard_auth -->|"Verifica token externo en<br/>[In-Process / DI]"| srv_supabase

    ctrl_qr -->|"Delega generación QR a<br/>[In-Process / DI]"| srv_qr
    ctrl_acc -->|"Delega control y sync a<br/>[In-Process / DI]"| srv_acc_be

    %% Servicios internos y dependencias de otros módulos
    srv_qr -->|"Verifica membresía activa en<br/>[In-Process / DI]"| srv_membresias
    srv_qr -->|"Obtiene ciudad origen desde<br/>[In-Process / DI]"| srv_usuarios

    srv_acc_be -->|"Valida firma y TTL QR en<br/>[In-Process / DI]"| srv_qr
    srv_acc_be -->|"Valida membresía y mora en<br/>[In-Process / DI]"| srv_membresias
    srv_acc_be -->|"Busca socio por DNI/ID en<br/>[In-Process / DI]"| srv_usuarios
    srv_acc_be -->|"Persiste ingresos/egresos en<br/>[In-Process / DI]"| repo_acc
    srv_acc_be -->|"Notifica cambio de aforo a<br/>[In-Process / DI]"| srv_aforo_rt

    srv_aforo_rt -->|"Solicita broadcast aforo a<br/>[In-Process / DI]"| srv_supabase

    %% Infraestructura externa
    repo_acc -->|"Transacciona registros en<br/>[SQL/TCP]"| db
    srv_supabase -->|"Valida tokens en<br/>[JSON/HTTPS]"| sb_auth_rt
    srv_supabase -->|"Publica aforo_actualizado hacia<br/>[WebSocket]"| sb_auth_rt
    comp_recep -->|"Suscribe a canal aforo:sede:{idSede} en<br/>[WebSocket]"| sb_auth_rt
    sb_auth_rt -->|"Empuja aforo_actualizado en vivo hacia<br/>[WebSocket]"| comp_recep